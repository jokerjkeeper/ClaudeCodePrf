{
  "permissions": {
    "allow": [
      "Bash(npx skills:*)",
      "Bash(apify login:*)",
      "Bash(wc:*)",
      "Bash(xargs ls:*)",
      "Bash(find \"J:/git/ClaudeCodePrf\" -name \"*spc*\" -o -name \"*spec*\" 2>/dev/null | head -20)",
      "Bash(bash \"J:/git/ClaudeCodePrf/.claude/scripts/load-specs.sh\")",
      "Bash(ls -d .claude/skills/apify-* | wc -l)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/load-specs.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "apify-ultimate-scraper@apify-agent-skills": true
  }
}
